# server/.env dosyasına kopyalayıp doldurun (gerçek .env asla git'e eklenmemeli).

# PostgreSQL bağlantı adresi.
# Yerel geliştirme:      postgres://postgres:ŞİFRENİZ@localhost:5432/dikkat_gelistirme
# Barındırma sağlayıcısı (Neon/Supabase/RDS vb.) bu değişkeni doğrudan verir.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dikkat_gelistirme

# JWT imzalama anahtarı — prod'da mutlaka değiştirin, rastgele uzun bir değer kullanın.
JWT_SECRET=dikkat-gelistirme-demo-secret-key

PORT=3333
